# Pinned CI host runtimes. Bump these together after re-running both live E2E suites.
# Workflows load KEY=VALUE lines only; comments and blanks are skipped.
# The Pi development SDK in packages/pi-extension/package.json can lag this pin;
# E2E installs these exact host binaries, not the SDK version.
NODE_VERSION=24
PI_VERSION=0.85.1
CLAUDE_CODE_VERSION=2.1.275
