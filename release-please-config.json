{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "compact-adviser",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/pi-extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/claude-mod/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/claude-mod/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "json",
          "path": "packages/codex-plugin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/codex-plugin/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
